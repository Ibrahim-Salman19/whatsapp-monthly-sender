# Encryption key for session credentials (auto-generated on first run)
# Do NOT commit this file
SESSION_ENCRYPTION_KEY=

# Your phone number (digits only, with country code, no + sign)
# Example for Pakistan: 923001234567
OWNER_PHONE=

# Timezone (default: Asia/Karachi)
TIMEZONE=Asia/Karachi

# Server port for dashboard
PORT=3000
