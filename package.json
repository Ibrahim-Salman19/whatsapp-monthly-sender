{
  "name": "whatsapp-monthly-sender",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"import('fs').then(fs => { fs.mkdirSync('dist/api', { recursive: true }); fs.copyFileSync('src/api/dashboard.html', 'dist/api/dashboard.html'); })\"",
    "start": "node dist/index.js",
    "send": "tsx src/index.ts --send-now",
    "run-now": "tsx src/index.ts --run-now",
    "status": "tsx src/index.ts --status",
    "test": "tsx tests/index.test.ts"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@types/qrcode": "^1.5.6",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.9.1",
    "cookie-session": "^2.1.1",
    "croner": "^10.0.1",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^5.0.2",
    "@types/node": "^24.0.10",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
